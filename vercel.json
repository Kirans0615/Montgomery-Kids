{
  "redirects": [
    { "source": "/25726-2/", "destination": "/programs", "permanent": true },
    { "source": "/25726-2", "destination": "/programs", "permanent": true },
    { "source": "/blog-2/:path*", "destination": "/blog", "permanent": true },
    { "source": "/blog-2", "destination": "/blog", "permanent": true },
    { "source": "/overview/", "destination": "/about-us", "permanent": true },
    { "source": "/overview", "destination": "/about-us", "permanent": true },
    { "source": "/about-us/", "destination": "/about-us", "permanent": true },
    { "source": "/our-stories/", "destination": "/our-stories", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(images|og|videos)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
